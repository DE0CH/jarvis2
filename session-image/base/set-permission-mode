#!/bin/bash
# In-place permission-mode switch. Run as user `claude` (Jarvis execs it via
# `sudo -u claude -H` — see setPermissionMode in jarvis/server.js). Switches the session between
# "auto" and "bypass" (--dangerously-skip-permissions) WITHOUT a Fly machine restart: it updates
# the mode harness-claude.sh's start() reads, then kills just the claude tmux session. The
# launcher's watchdog (harness-claude.sh) relaunches claude in the new mode, `--resume`ing
# the same conversation — so the machine's ephemeral state (/tmp, tunnels, browser logins,
# background jobs) all survive. The old path patched the machine env var and let Fly replace the
# config, which restarts the whole machine and resets the rootfs (i.e. wipes everything).
set -u
export HOME=/home/claude
mode="${1:-auto}"
case "$mode" in bypass) : ;; *) mode=auto ;; esac
mkdir -p "$HOME/.claude"
printf '%s\n' "$mode" > "$HOME/.claude/.permission-mode"
# Killing the "claude" tmux session stops only the claude CLI, not the launcher (it runs as the
# machine entrypoint, outside tmux); the watchdog then relaunches within ~5 s in the new mode.
tmux kill-session -t claude 2>/dev/null || true
echo "[set-permission-mode] mode=$mode; claude restarting in-place"
