#!/usr/bin/env python3
"""Push this session's ~/.claude/.credentials.json back to Jarvis whenever it changes.

Claude rotates the OAuth refresh token every time it refreshes the access token; the copy
Jarvis stores (and injects into NEW sessions) would go stale after the first refresh.
So every session runs this loop (started by session-supervisor.sh): poll the file, and POST
it to $JARVIS_URL/api/credentials when its content changes. Jarvis keeps whichever pair
expires latest. Auth = the Cloudflare Access service token from the environment secrets.
Token values are never printed; the log only records outcomes."""
import hashlib, json, os, sys, time, urllib.request, urllib.error

HOME = os.path.expanduser("~")
CREDS = os.path.join(HOME, ".claude", ".credentials.json")
ACCOUNT = os.path.join(HOME, ".claude.json")
JARVIS = (os.environ.get("JARVIS_URL") or "https://jarvis.deyaochen.com").rstrip("/")
CID, CSEC = os.environ.get("CF_ACCESS_CLIENT_ID", ""), os.environ.get("CF_ACCESS_CLIENT_SECRET", "")
INTERVAL = int(os.environ.get("CREDS_PUSH_INTERVAL", "30"))
LOG = os.path.join(HOME, ".claude", "credentials-push.log")

def log(msg):
    with open(LOG, "a") as f: f.write(time.strftime("%Y-%m-%dT%H:%M:%SZ ", time.gmtime()) + msg + "\n")

def push(raw):
    try: acct = {k: v for k, v in json.load(open(ACCOUNT)).items() if k in ("oauthAccount", "userID")}
    except Exception: acct = None
    body = {"credentials": raw}
    if acct: body["account"] = json.dumps(acct)
    req = urllib.request.Request(JARVIS + "/api/credentials", data=json.dumps(body).encode(),
        headers={"Content-Type": "application/json", "CF-Access-Client-Id": CID, "CF-Access-Client-Secret": CSEC,
                 # Cloudflare's browser-integrity check 403s (error 1010) urllib's default UA
                 "User-Agent": "claude-session-credentials-push/1"})
    with urllib.request.urlopen(req, timeout=30) as r: return json.loads(r.read().decode() or "{}")

def main():
    if not (CID and CSEC):
        log("no CF_ACCESS_CLIENT_ID/SECRET in the environment; credentials write-back disabled"); return
    last = None  # sha256 of the last content we pushed (or that was already stored)
    once = "--once" in sys.argv
    while True:
        try:
            raw = open(CREDS).read()
            h = hashlib.sha256(raw.encode()).hexdigest()
            if h != last:
                exp = json.loads(raw).get("claudeAiOauth", {}).get("expiresAt")
                try:
                    r = push(raw)
                    log(f"pushed credentials (expiresAt {exp}): stored={r.get('stored')} {r.get('reason','')}".strip())
                    last = h
                except urllib.error.HTTPError as e:
                    log(f"jarvis rejected push: HTTP {e.code} {e.read().decode()[:200]}")
                    if e.code == 400: last = h  # malformed for Jarvis; don't retry the same bytes
                except Exception as e:
                    log(f"push failed (will retry): {e}")
        except FileNotFoundError:
            pass
        except Exception as e:
            log(f"error: {e}")
        if once: return
        time.sleep(INTERVAL)

if __name__ == "__main__":
    main()
