#!/bin/sh
# `openclaw` for an OpenClaw session. OpenClaw (Deyao's fork DE0CH/openclaw) + the Node 26 it needs are NOT in
# the session image — Fly refuses an image over 8 GB unpacked and the image sits at that limit — but in a
# runtime bundle the fork's CI builds on every push to its main, pinned in /usr/local/share/forks.json
# ("openclaw": {url, sha}). The first call fetches + unpacks it (~seconds) into ~/.cache/openclaw-runtime/<sha>,
# under a lock so parallel callers wait for one download; later calls just exec it.
set -e
PIN=/usr/local/share/forks.json
url="$(python3 -c "import json;print(json.load(open('$PIN'))['openclaw']['url'])")"
sha="$(python3 -c "import json;print(json.load(open('$PIN'))['openclaw']['sha'][:12])")"
dir="$HOME/.cache/openclaw-runtime/$sha"
if [ ! -x "$dir/openclaw/bin/openclaw" ]; then
  mkdir -p "$HOME/.cache/openclaw-runtime"
  (
    flock 9
    if [ ! -x "$dir/openclaw/bin/openclaw" ]; then
      echo "openclaw: fetching the runtime bundle $sha" >&2
      tmp="$dir.tmp.$$"; rm -rf "$tmp"; mkdir -p "$tmp"
      curl -fsSL --retry 3 "$url" | tar -xz -C "$tmp"
      rm -rf "$dir"; mv "$tmp" "$dir"
      # older bundles are dead weight once a newer pin is in use
      for old in "$HOME/.cache/openclaw-runtime"/*; do [ "$old" = "$dir" ] || case "$old" in *.lock) ;; *) rm -rf "$old";; esac; done
    fi
  ) 9>"$HOME/.cache/openclaw-runtime/.lock"
fi
PATH="$dir/node/bin:$PATH" exec "$dir/openclaw/bin/openclaw" "$@"
