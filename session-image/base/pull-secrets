#!/usr/bin/env python3
"""This session's secrets, from the supervisor (RAM only) — WITHOUT ever printing a value.

The supervisor (jarvis2-machine, machine/secrets.go) pulls the session's stores from the core and holds them in RAM;
nothing keeps them on disk. A process's env is fixed when it starts, so a store added or refreshed afterwards (an
add-store, a refresh, a downgrade) reaches a command only through this. Every request is logged in the supervisor log
with the key names and this process's pid, never a value.

Safety: stdout ends up in the session transcript, so NO mode prints a secret value. Anything that
isn't exactly one of the commands below (no args, --help, a typo, a missing argument) prints this
usage and exits 2 WITHOUT asking the supervisor.

Usage:
  pull-secrets --names              # the key names, one per line
  pull-secrets --write FILE         # write `export KEY='value'` lines to FILE (mode 600); prints only the key names
  pull-secrets --exec CMD [ARG...]  # run CMD with the secrets as they are now added to its environment
                                    #   (e.g. pull-secrets --exec python3 script.py) — make sure CMD itself
                                    #   doesn't echo them

It asks the supervisor's unix socket (/run/jarvis2/secrets.sock, only this user can reach it).
"""
import json, os, shlex, socket, sys

SOCK = "/run/jarvis2/secrets.sock"


def die(msg, code=1):
    print(f"pull-secrets: {msg}", file=sys.stderr); sys.exit(code)


def usage():
    print(__doc__.strip(), file=sys.stderr); sys.exit(2)


def ask(op):
    try:
        s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
        s.settimeout(60)
        s.connect(SOCK)
        s.sendall((json.dumps({"op": op}) + "\n").encode())
        buf = b""
        while True:
            b = s.recv(65536)
            if not b:
                break
            buf += b
        s.close()
        r = json.loads(buf.decode() or "{}")
    except (OSError, ValueError) as e:
        die(f"the supervisor's secrets aren't reachable ({e.__class__.__name__})")
    if not r.get("ok"):
        die("the supervisor said: " + str(r.get("error", "no answer"))[:300])
    return r


def main():
    a = sys.argv[1:]
    # validate BEFORE asking: a wrong invocation must never reach the values
    if a == ["--names"]:
        for k in ask("names").get("names") or []: print(k)
    elif len(a) == 2 and a[0] == "--write" and not a[1].startswith("-"):
        secrets = ask("all").get("secrets") or {}
        with open(os.open(a[1], os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600), "w") as f:
            for k in sorted(secrets): f.write(f"export {k}={shlex.quote(str(secrets[k]))}\n")
        os.chmod(a[1], 0o600)
        print(f"wrote {len(secrets)} secret(s) to {a[1]}: {', '.join(sorted(secrets))}")
    elif len(a) >= 2 and a[0] == "--exec":
        secrets = ask("all").get("secrets") or {}
        env = {**os.environ, **{k: str(v) for k, v in secrets.items()}}
        os.execvpe(a[1], a[1:], env)
    else:
        usage()


if __name__ == "__main__":
    main()
