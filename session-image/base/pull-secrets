#!/usr/bin/env python3
"""Pull this session's OWN secret store from Jarvis — the CURRENT values, live — WITHOUT ever printing a value.

A session's process env is frozen at boot, so a secret added/rotated in the store afterwards is
not visible to the already-running process. This fetches the up-to-date secrets of the store(s)
this session was booted from so a file or a child process can use them — no machine restart (that
is what `/env-resync` does instead).

Safety: stdout ends up in the session transcript, so NO mode prints a secret value. Anything that
isn't exactly one of the commands below (no args, --help, a typo, a missing argument) prints this
usage and exits 2 WITHOUT contacting Jarvis.

Usage:
  pull-secrets --names              # the key names, one per line
  pull-secrets --write FILE         # write `export KEY='value'` lines to FILE (mode 600); prints only the key names
  pull-secrets --exec CMD [ARG...]  # run CMD with the fresh secrets added to its environment
                                    #   (e.g. pull-secrets --exec python3 script.py) — make sure CMD itself
                                    #   doesn't echo them

It calls the machine's local Jarvis API ($JARVIS_URL, default http://127.0.0.1:7171), which signs the
call with the machine key; the answer is this session's own secrets, sealed to this machine and
opened by the proxy. SESSION_API_TOKEN and the CF headers are constants there (defaults apply in a
shell without the agent's env, e.g. a grant's).
"""
import json, os, shlex, sys, urllib.request, urllib.error

JARVIS = os.environ.get("JARVIS_URL", "http://127.0.0.1:7171").rstrip("/")  # the machine's local proxy to Jarvis 2 (it signs every call)
TOKEN = os.environ.get("SESSION_API_TOKEN", "jarvis2-local-proxy")  # a constant: the proxy's machine signature authorises
MID = os.environ.get("SESSION_ID") or os.environ.get("FLY_MACHINE_ID", "")  # Jarvis session id (a machine id resolves too)
CID, CSEC = os.environ.get("CF_ACCESS_CLIENT_ID", ""), os.environ.get("CF_ACCESS_CLIENT_SECRET", "")

def die(msg, code=1):
    print(f"pull-secrets: {msg}", file=sys.stderr); sys.exit(code)

def usage():
    print(__doc__.strip(), file=sys.stderr); sys.exit(2)

def fetch():
    if not MID: die("SESSION_ID / FLY_MACHINE_ID not set (are we on a Fly session machine?)")
    req = urllib.request.Request(f"{JARVIS}/api/sessions/{MID}/secrets",
        headers={"Authorization": f"Bearer {TOKEN}",
                 # perimeter gate only — Jarvis authorizes by the session token above
                 "CF-Access-Client-Id": CID, "CF-Access-Client-Secret": CSEC,
                 # Cloudflare's browser-integrity check 403s (error 1010) urllib's default UA
                 "User-Agent": "claude-session-pull-secrets/1"})
    try:
        with urllib.request.urlopen(req, timeout=30) as r:
            return json.loads(r.read().decode() or "{}").get("secrets", {})
    except urllib.error.HTTPError as e:
        # only the proxy's `error` field (an error answer carries no values), never the raw body
        why = ""
        try: why = str(json.loads(e.read().decode() or "{}").get("error", ""))[:300]
        except Exception: pass
        die(f"jarvis returned HTTP {e.code}" + (f": {why}" if why else ""))

def main():
    a = sys.argv[1:]
    # validate BEFORE fetching: a wrong invocation must never reach the values
    if a == ["--names"]:
        for k in sorted(fetch()): print(k)
    elif len(a) == 2 and a[0] == "--write" and not a[1].startswith("-"):
        secrets = fetch()
        with open(os.open(a[1], os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600), "w") as f:
            for k in sorted(secrets): f.write(f"export {k}={shlex.quote(str(secrets[k]))}\n")
        os.chmod(a[1], 0o600)
        print(f"wrote {len(secrets)} secret(s) to {a[1]}: {', '.join(sorted(secrets))}")
    elif len(a) >= 2 and a[0] == "--exec":
        secrets = fetch()
        env = {**os.environ, **{k: str(v) for k, v in secrets.items()}}
        os.execvpe(a[1], a[1:], env)
    else:
        usage()

if __name__ == "__main__":
    main()
